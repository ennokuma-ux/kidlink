<?php

use App\Http\Controllers\Teacher\IndividualAnalyticsController;
use Illuminate\Support\Facades\Route;

Route::middleware(['auth'])
    ->prefix('teacher/analytics/individual')
    ->name('teacher.analytics.individual.')
    ->group(function () {
        Route::get('/', [IndividualAnalyticsController::class, 'index'])->name('index');
        Route::get('/{studentId}', [IndividualAnalyticsController::class, 'show'])
            ->whereNumber('studentId')
            ->name('show');
    });
