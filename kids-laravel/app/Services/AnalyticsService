    /**
     * Average age of enrolled students.
     */
    public function averageAge(?array $studentIds = null): float
    {
        $query = Student::whereNotNull('date_of_birth');

        if ($studentIds !== null) {
            $query->whereIn('id', $studentIds);
        }

        $students = $query->get(['date_of_birth']);

        if ($students->isEmpty()) {
            return 0.0;
        }

        return round($students->avg(fn($s) => Carbon::parse($s->date_of_birth)->age), 1);
    }

