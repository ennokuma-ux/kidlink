    /**
     * Accuracy used by every game-related statistic: correct answers divided
     * by total attempts, where each recorded mistake counts against the
     * result. Equal to score/total when no mistakes have been recorded.
     */
    public const ACCURACY_SQL = 'AVG(100.0 * game_scores.score / NULLIF(game_scores.total + COALESCE(game_scores.mistakes, 0), 0))';

