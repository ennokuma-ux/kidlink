    /**
     * Descriptive label for a percentage, so charts and tables read consistently.
     */
    public function describe(float $pct): string
    {
        return match (true) {
            $pct >= 90 => __('analytics.describe_excellent'),
            $pct >= 75 => __('analytics.describe_good'),
            $pct >= 60 => __('analytics.describe_fair'),
            $pct >= 40 => __('analytics.describe_needs_work'),
            default => __('analytics.describe_critical'),
        };
    }

    /**
     * Sections that actually have students, canonical order first so a legacy
     * value on an old row stays selectable instead of disappearing.
     *
     * @return array<int, string>
     */
    public function availableSections($students): array
    {
        $present = $students->pluck('class_name')->filter()->unique()->values();

        return collect(Student::SECTIONS)
            ->merge($present->reject(fn ($name) => in_array($name, Student::SECTIONS, true)))
            ->filter(fn ($name) => $present->contains($name))
            ->values()
            ->all();
    }

    /**
     * Label, colour and head count per section for the legend. Ordered
     * canonically, with anything unassigned always last.
     */
    public function sectionLegend($students): array
    {
        $counts = $students
            ->groupBy(fn (Student $student) => Student::sectionLabel($student->class_name))
            ->map->count();

        $labels = collect(Student::SECTIONS)
            ->merge($counts->keys()->reject(fn ($label) => in_array($label, Student::SECTIONS, true)))
            ->reject(fn ($label) => $label === Student::UNASSIGNED_SECTION)
            ->push(Student::UNASSIGNED_SECTION)
            ->filter(fn ($label) => $counts->has($label))
            ->unique()
            ->values();

        return $labels
            ->map(fn (string $label) => [
                'label' => $label,
                'color' => Student::colorForSection($label === Student::UNASSIGNED_SECTION ? null : $label),
                'total' => $counts->get($label, 0),
            ])
            ->all();
    }

    /**
     * Orders student level rows by section, by name, or leaves the ranking the
     * query produced untouched. Rows may carry their own class_name, or the
     * section can be looked up from the id map the caller already has.
     */
    public function sortStudentRows(array $rows, string $sort, array $sectionByStudent = []): array
    {
        if ($sort === 'name') {
            usort($rows, fn ($a, $b) => strcasecmp((string) ($a['name'] ?? ''), (string) ($b['name'] ?? '')));

            return $rows;
        }

        if ($sort !== 'section') {
            return $rows;
        }

        $sectionFor = function (array $row) use ($sectionByStudent) {
            if (array_key_exists('class_name', $row)) {
                return $row['class_name'];
            }

            return $sectionByStudent[$row['student_id'] ?? null] ?? null;
        };

        usort($rows, function ($a, $b) use ($sectionFor) {
            return $this->sectionSortKey($sectionFor($a)) <=> $this->sectionSortKey($sectionFor($b));
        });

        return $rows;
    }

    /**
     * Canonical sections first, unassigned last, label A-Z inside each group.
     */
    private function sectionSortKey(?string $section): array
    {
        $index = array_search($section, Student::SECTIONS, true);

        return [
            $index === false ? count(Student::SECTIONS) : $index,
            Student::sectionLabel($section),
        ];
    }

    /**
     * Sort a list of rows that carry an avg_pct key, highest first.
     */
    private function sortByPct(array $rows, int $limit): array
    {
        usort($rows, fn($a, $b) => $b['avg_pct'] <=> $a['avg_pct']);

        return array_slice($rows, 0, $limit);
    }
