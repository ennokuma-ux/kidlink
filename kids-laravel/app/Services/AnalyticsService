    public const EXCEEDING_PCT = 75;
    public const STRUGGLING_PCT = 60;

    /**
     * Per-topic standings: which students are exceeding and which are
     * struggling, across games, ECCD domains and activity areas.
     */
    public function topicStandings(array $studentIds, int $maxNames = 4): array
    {
        if (empty($studentIds)) {
            return [];
        }

        $names = Student::whereIn('id', $studentIds)->get(['id', 'first_name', 'last_name'])
            ->mapWithKeys(fn($s) => [$s->id => $s->name]);

        $gameOrder = array_flip(self::GAME_TYPES);
        $domainOrder = array_flip(self::ECCD_DOMAINS);

        $byBasis = [
            'Game' => [
                'order' => $gameOrder,
                'rows' => GameScore::whereIn('student_id', $studentIds)
                    ->selectRaw('student_id, game_type as topic, ' . self::ACCURACY_SQL . ' as pct')
                    ->groupBy('student_id', 'game_type')
                    ->get(),
            ],
            'Domain' => [
                'order' => $domainOrder,
                'rows' => EccdRecord::whereIn('student_id', $studentIds)
                    ->selectRaw("student_id, domain as topic, SUM(CASE WHEN status = 'Achieved' THEN 1 ELSE 0 END) * 100.0 / NULLIF(COUNT(*), 0) as pct")
                    ->groupBy('student_id', 'domain')
                    ->get(),
            ],
            'Activity' => [
                'order' => null,
                'rows' => ActivityAttendance::whereIn('student_id', $studentIds)
                    ->join('activities', 'activity_attendance.activity_id', '=', 'activities.id')
                    ->selectRaw('activity_attendance.student_id, activities.type as topic, AVG(activity_attendance.score) as pct')
                    ->groupBy('activity_attendance.student_id', 'activities.type')
                    ->get(),
            ],
        ];

        $standings = [];

        foreach ($byBasis as $basis => $group) {
            $items = [];

            foreach ($group['rows']->groupBy('topic') as $topic => $rows) {
                $people = $rows
                    ->map(fn($r) => [
                        'id' => (int) $r->student_id,
                        'name' => $names[$r->student_id] ?? 'Unknown',
                        'pct' => (int) round((float) $r->pct),
                    ])
                    ->sortByDesc('pct')
                    ->values();

                if ($people->isEmpty()) {
                    continue;
                }

                $items[] = [
                    'topic' => $topic,
                    'basis' => $basis,
                    'participants' => $people->count(),
                    'avg' => (int) round($people->avg('pct')),
                    'exceeding' => $people
                        ->filter(fn($p) => $p['pct'] >= self::EXCEEDING_PCT)
                        ->take($maxNames)
                        ->values()
                        ->all(),
                    'struggling' => $people
                        ->filter(fn($p) => $p['pct'] < self::STRUGGLING_PCT)
                        ->sortBy('pct')
                        ->take($maxNames)
                        ->values()
                        ->all(),
                    '_order' => $group['order'][$topic] ?? PHP_INT_MAX,
                ];
            }

            usort($items, $group['order'] === null
                ? fn($a, $b) => $b['avg'] <=> $a['avg']
                : fn($a, $b) => $a['_order'] <=> $b['_order']);

            $standings = array_merge($standings, $items);
        }

        return $standings;
    }

    /**
     * Weekly volume of completed game levels, to show engagement trend.
     */
    public function gamePlayTrend(?array $studentIds, int $weeks = 8): array
    {
        $start = Carbon::today()->startOfWeek()->subWeeks($weeks - 1);
        $trend = [];

        $query = GameScore::where('created_at', '>=', $start);
        if (!empty($studentIds)) {
            $query->whereIn('student_id', $studentIds);
        }

        // Bucketed in PHP rather than with DATE_TRUNC, which only exists on
        // some drivers. Same mean of per-row percentages as ACCURACY_SQL:
        // rows whose possible total is zero still count as a play but are
        // left out of the average.
        $buckets = [];

        foreach ($query->select(['created_at', 'score', 'total', 'mistakes'])->cursor() as $row) {
            $key = Carbon::parse($row->created_at)->startOfWeek()->format('Y-m-d');

            $buckets[$key] ??= ['plays' => 0, 'sum_pct' => 0.0, 'counted' => 0];
            $buckets[$key]['plays']++;

            $possible = (float) $row->total + (float) ($row->mistakes ?? 0);
            if ($possible > 0) {
                $buckets[$key]['sum_pct'] += 100.0 * (float) $row->score / $possible;
                $buckets[$key]['counted']++;
            }
        }

        for ($i = 0; $i < $weeks; $i++) {
            $week = $start->copy()->addWeeks($i);
            $bucket = $buckets[$week->format('Y-m-d')] ?? null;

            $trend[] = [
                'week' => $week->format('j M'),
                'plays' => (int) ($bucket['plays'] ?? 0),
                'avg_pct' => $bucket && $bucket['counted'] > 0
                    ? (int) round($bucket['sum_pct'] / $bucket['counted'])
                    : 0,
            ];
        }

        return $trend;
    }

    /**
     * Headline statistics for a set of students.
     */
    public function summary(?array $studentIds): array
    {
        $summary = [
            'students' => 0,
            'active_students' => 0,
            'games_played' => 0,
            'avg_game_pct' => 0,
            'attendance_rate' => 0,
            'absences' => 0,
            'late_count' => 0,
            'points_awarded' => 0,
        ];

        $studentQuery = Student::query();
        if (!empty($studentIds)) {
            $studentQuery->whereIn('id', $studentIds);
        }

        $summary['students'] = (clone $studentQuery)->count();
        $summary['active_students'] = (clone $studentQuery)->where('is_active', true)->count();

        $scoreQuery = GameScore::query();
        $pointQuery = Point::query();
        $attendanceQuery = Attendance::query();

        if (!empty($studentIds)) {
            $scoreQuery->whereIn('student_id', $studentIds);
            $pointQuery->whereIn('student_id', $studentIds);
            $attendanceQuery->whereIn('student_id', $studentIds);
        }

        $summary['games_played'] = (clone $scoreQuery)->count();
        $summary['avg_game_pct'] = (int) round((float) $scoreQuery->avg('percentage'));
        $summary['points_awarded'] = (int) (clone $pointQuery)->sum('points_earned');

        $attendance = $attendanceQuery
            ->selectRaw('status, COUNT(*) as total')
            ->groupBy('status')
            ->pluck('total', 'status');

        $present = (int) ($attendance['Present'] ?? 0);
        $attendanceTotal = (int) $attendance->sum();

        $summary['attendance_rate'] = $attendanceTotal > 0 ? round(($present / $attendanceTotal) * 100) : 0;
        $summary['absences'] = (int) ($attendance['Absent'] ?? 0);
        $summary['late_count'] = (int) ($attendance['Late'] ?? 0);

        return $summary;
    }

    /**
     * Builds real, data-driven intervention notes for each student:
     * weak ECCD domains (< 50%) and weak games (< 60%) become "needs",
     * and the matching activity plan becomes the suggestion.
     */
    public function studentRecommendations(array $studentIds, int $limit = 6): array
    {
        if (empty($studentIds)) {
            return [];
        }

        $domainRows = EccdRecord::whereIn('student_id', $studentIds)
            ->selectRaw('student_id, domain, COUNT(*) as total, SUM(CASE WHEN status = \'Achieved\' THEN 1 ELSE 0 END) as achieved')
            ->groupBy('student_id', 'domain')
            ->get()
            ->groupBy('student_id');

        $gameRows = GameScore::whereIn('student_id', $studentIds)
            ->selectRaw('student_id, game_type, ' . self::ACCURACY_SQL . ' as avg_pct')
            ->groupBy('student_id', 'game_type')
            ->get()
            ->groupBy('student_id');

        $attendanceRows = Attendance::whereIn('student_id', $studentIds)
            ->selectRaw('student_id, status, COUNT(*) as total')
            ->groupBy('student_id', 'status')
            ->get()
            ->groupBy('student_id');

        $students = Student::whereIn('id', $studentIds)->orderBy('first_name')->get();
        $recommendations = [];

        foreach ($students as $student) {
            $needs = [];
            $plans = [];

            foreach (self::ECCD_DOMAINS as $domain) {
                $row = $domainRows->get($student->id, collect())->firstWhere('domain', $domain);
                $total = (int) ($row->total ?? 0);

                if ($total === 0) {
                    continue;
                }

                $pct = round(((int) $row->achieved / $total) * 100);

                if ($pct < 50) {
                    $needs[] = $domain;
                    $plans[] = ucfirst(self::DOMAIN_ACTIVITIES[$domain]);
                }
            }

            foreach ($gameRows->get($student->id, collect()) as $game) {
                $pct = (int) round((float) $game->avg_pct);

                if ($pct < 60) {
                    $needs[] = ucfirst($game->game_type);
                    $plans[] = 'targeted ' . $game->game_type . ' levels on KidLink';
                }
            }

            $statusCounts = $attendanceRows->get($student->id, collect())->pluck('total', 'status');
            $absent = (int) ($statusCounts['Absent'] ?? 0);
            $late = (int) ($statusCounts['Late'] ?? 0);

            if ($absent >= 3) {
                $needs[] = 'Attendance';
                $plans[] = 'follow up with the family about attendance';
            } elseif ($late >= 3) {
                $needs[] = 'Punctuality';
                $plans[] = 'set a morning routine to reduce late arrivals';
            }

            if (empty($needs)) {
                continue;
            }

            $recommendations[] = [
                'student_id' => $student->id,
                'name' => $student->name,
                'needs' => implode(', ', array_slice($needs, 0, 4)),
                'plan' => implode('; ', array_slice(array_values(array_unique($plans)), 0, 3)),
                'severity' => count($needs) >= 3 ? 'high' : (count($needs) === 2 ? 'medium' : 'low'),
                'gap_count' => count($needs),
            ];
        }

        usort($recommendations, fn($a, $b) => $b['gap_count'] <=> $a['gap_count']);

        return array_slice($recommendations, 0, $limit);
    }

    /**
     * Students with a measurable hole in their record, as opposed to a merely
     * low score: attendance that has not been confirmed, or a topic with nothing
     * recorded against it at all.
     *
     * This is deliberately separate from studentRecommendations(). That method
     * asks "how are they doing", and it skips anything unassessed, so a child
     * with no records anywhere looks identical to a child who is doing fine.
     * This asks "is anything missing", which is the question a teacher needs
     * answered before a gap can be spotted in a table of averages.
     *
     * A child with nothing at all is reported once as a missing baseline rather
     * than as eleven separate missing topics, so a new enrolment reads as "get a
     * baseline" instead of flooding the list.
     *
     * @return array<int, array{
     *     student_id: int, name: string, class_name: string|null,
     *     intervention_required: bool, severity: string, gap_count: int,
     *     reasons: array<int, array{type: string, label: string, message: string, action: string}>
     * }>
     */
    public function interventionFlags(array $studentIds): array
    {
        if (empty($studentIds)) {
            return [];
        }

        $students = Student::whereIn('id', $studentIds)
            ->orderBy('first_name')
            ->get(['id', 'first_name', 'last_name', 'class_name']);

        $from = Carbon::today()->subDays(self::ATTENDANCE_WINDOW_DAYS);

        $attendance = Attendance::whereIn('student_id', $studentIds)
            ->where('date', '>=', $from)
            ->selectRaw('student_id, status, COUNT(*) as total')
            ->groupBy('student_id', 'status')
            ->get()
            ->groupBy('student_id');

        $playedGames = GameScore::whereIn('student_id', $studentIds)
            ->select('student_id', 'game_type')
            ->distinct()
            ->get()
            ->groupBy('student_id');

        $assessedDomains = EccdRecord::whereIn('student_id', $studentIds)
            ->select('student_id', 'domain')
            ->distinct()
            ->get()
            ->groupBy('student_id');

        $flags = [];

        foreach ($students as $student) {
            $reasons = [];
            $attendanceReason = $this->attendanceGap($attendance->get($student->id, collect()));

            $games = $playedGames->get($student->id, collect())->pluck('game_type')->all();
            $domains = $assessedDomains->get($student->id, collect())->pluck('domain')->all();

            $missingGames = array_values(array_diff(self::GAME_TYPES, $games));
            $missingDomains = array_values(array_diff(self::ECCD_DOMAINS, $domains));

            $blank = $games === [] && $domains === [];

            // An empty register is already covered by the "no records" line
            // below, so restating it would be noise. A measured rate is not: a
            // child at 60% has been marked, and that still needs saying.
            $attendanceUnmarked = $attendanceReason !== null && $attendanceReason['marked'] === 0;

            if ($attendanceReason !== null && ! ($blank && $attendanceUnmarked)) {
                $reasons[] = $attendanceReason;
            }

            if ($blank) {
                // Name only what is actually absent, so a child whose register
                // is filled in is not told they have no attendance.
                $absent = $attendanceUnmarked ? ['attendance'] : [];
                $absent[] = 'game scores';
                $absent[] = 'ECCD records';

                $reasons[] = [
                    'type' => 'Baseline',
                    'label' => __('intervention.baseline_label'),
                    'message' => __('intervention.baseline_message', ['list' => implode(', ', $absent)]),
                    'action' => __('intervention.baseline_action'),
                ];
            } else {
                if ($missingGames !== []) {
                    $reasons[] = [
                        'type' => 'Game',
                        'label' => __('intervention.game_label', ['list' => implode(', ', array_map('ucfirst', $missingGames))]),
                        'message' => __('intervention.game_message', ['missing' => count($missingGames), 'total' => count(self::GAME_TYPES)]),
                        'action' => __('intervention.game_action', ['list' => implode(', ', $missingGames)]),
                    ];
                }

                if ($missingDomains !== []) {
                    $reinforcing = array_values(array_unique(array_merge(
                        ...array_map(fn ($domain) => self::DOMAIN_GAMES[$domain], $missingDomains)
                    )));

                    $reasons[] = [
                        'type' => 'Domain',
                        'label' => __('intervention.domain_label', ['list' => implode(', ', $missingDomains)]),
                        'message' => __('intervention.domain_message', ['missing' => count($missingDomains), 'total' => count(self::ECCD_DOMAINS)]),
                        'action' => __('intervention.domain_action', ['list' => implode(', ', $missingDomains)])
                            .($reinforcing === [] ? '' : __('intervention.domain_reinforce', ['games' => implode(', ', $reinforcing)])),
                    ];
                }
            }

            if ($reasons === []) {
                continue;
            }

            $flags[] = [
                'student_id' => $student->id,
                'name' => $student->name,
                'class_name' => $student->class_name,
                'intervention_required' => $this->needsIntervention($reasons),
                'severity' => $this->flagSeverity($reasons, count($missingGames) + count($missingDomains)),
                'gap_count' => count($reasons),
                'reasons' => $reasons,
            ];
        }

        // Severity has an order of its own; sorting the words alphabetically
        // would put "medium" above "high" and bury the urgent cases.
        $rank = ['high' => 0, 'medium' => 1, 'low' => 2];

        usort($flags, function ($a, $b) use ($rank) {
            if ($a['intervention_required'] !== $b['intervention_required']) {
                return $a['intervention_required'] ? -1 : 1;
            }

            return [$rank[$a['severity']] ?? 3, -$a['gap_count'], $a['name']]
                <=> [$rank[$b['severity']] ?? 3, -$b['gap_count'], $b['name']];
        });

        return $flags;
    }

    /**
     * Attendance gaps are graded on how bad they are, so the flag carries the
     * measured rate rather than a bare "low".
     *
     * @return array{type: string, label: string, message: string, action: string, rate: int|null, marked: int}|null
     */
    private function attendanceGap(Collection $rows): ?array
    {
        $counts = $rows->pluck('total', 'status');
        $marked = (int) $rows->sum('total');

        // Excused time is still time the child was not in the room, which is what
        // "lacking attendance" means here.
        $missed = (int) ($counts['Absent'] ?? 0) + (int) ($counts['Excused'] ?? 0);

        if ($marked === 0) {
            return [
                'type' => 'Attendance',
                'label' => __('intervention.attendance_unmarked_label'),
                'message' => __('intervention.attendance_unmarked_message', ['days' => self::ATTENDANCE_WINDOW_DAYS]),
                'action' => __('intervention.attendance_unmarked_action'),
                'rate' => null,
                'marked' => 0,
            ];
        }

        if ($marked < self::ATTENDANCE_MIN_DAYS) {
            return null;
        }

        $rate = (int) round((($marked - $missed) / $marked) * 100);

        if ($rate >= self::ATTENDANCE_MIN_RATE) {
            return null;
        }

        return [
            'type' => 'Attendance',
            'label' => __('intervention.low_attendance_label'),
            'message' => __('intervention.low_attendance_message', ['rate' => $rate, 'marked' => $marked, 'days' => self::ATTENDANCE_WINDOW_DAYS, 'missed' => $missed]),
            'action' => __('intervention.low_attendance_action'),
            'rate' => $rate,
            'marked' => $marked,
        ];
    }

    /**
     * Any hole in the record means someone has to act, so every flagged student
     * is called out. Severity, not this flag, decides who gets seen first.
     *
     * Counting reasons instead of gaps would be the trap here: the game and
     * domain reasons are each one grouped line, so a child missing most topics
     * would collapse to two reasons and read as "no intervention needed".
     */
    private function needsIntervention(array $reasons): bool
    {
        return $reasons !== [];
    }

    /**
     * @param  int  $missingTopics  how many individual games and domains are unrecorded
     */
    private function flagSeverity(array $reasons, int $missingTopics = 0): string
    {
        $attendance = null;

        foreach ($reasons as $reason) {
            if ($reason['type'] === 'Attendance') {
                $attendance = $reason;
            }
        }

        // Nothing in the register, attendance under 60%, or barely any coverage.
        if (collect($reasons)->contains(fn ($reason) => $reason['type'] === 'Baseline')) {
            return 'high';
        }

        if ($attendance !== null && ($attendance['marked'] === 0 || $attendance['rate'] < 60)) {
            return 'high';
        }

        if ($missingTopics >= 5) {
            return 'high';
        }

        if (($attendance !== null && $attendance['rate'] < self::ATTENDANCE_MIN_RATE) || $missingTopics >= 2) {
            return 'medium';
        }

        return 'low';
    }

