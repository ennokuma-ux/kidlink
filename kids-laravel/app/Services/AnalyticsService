    /**
     * Per-student percentage of ECCD indicators marked Achieved, for every
     * domain. Mirrors gameMasteryByStudent so the two can be shown side by side.
     */
    public function domainMasteryByStudent(array $studentIds): array
    {
        if (empty($studentIds)) {
            return [];
        }

        $students = Student::whereIn('id', $studentIds)->orderBy('first_name')->get();

        $rows = EccdRecord::whereIn('student_id', $studentIds)
            ->selectRaw('student_id, domain, COUNT(*) as total, SUM(CASE WHEN status = \'Achieved\' THEN 1 ELSE 0 END) as achieved')
            ->groupBy('student_id', 'domain')
            ->get()
            ->groupBy('student_id');

        $mastery = [];
        foreach ($students as $student) {
            $byDomain = $rows->get($student->id, collect())->keyBy('domain');
            $scores = [];
            $assessed = 0;

            foreach (self::ECCD_DOMAINS as $domain) {
                $row = $byDomain->get($domain);
                $total = (int) ($row->total ?? 0);

                if ($total === 0) {
                    $scores[$domain] = null;
                    continue;
                }

                $scores[$domain] = (int) round(((int) $row->achieved / $total) * 100);
                $assessed += $total;
            }

            $scored = array_filter($scores, fn($v) => $v !== null);
            $mastery[] = [
                'student_id' => $student->id,
                'name' => $student->name,
                'scores' => $scores,
                'overall' => $scored ? (int) round(array_sum($scored) / count($scored)) : null,
                'assessed' => $assessed,
            ];
        }

        return $mastery;
    }

    /**
     * Lifetime points earned per student, both in total and split by game type.
     *
     * Sums `points_earned` rather than `total_points`: the latter is a running
     * balance per game type written by Point::awardPoints, so adding it up would
     * count every earlier award again.
     */
    public function pointsByStudent(array $studentIds): array
    {
        if (empty($studentIds)) {
            return [];
        }

        $rows = Point::whereIn('student_id', $studentIds)
            ->selectRaw('student_id, game_type, SUM(points_earned) as points, COUNT(*) as awards')
            ->groupBy('student_id', 'game_type')
            ->get()
            ->groupBy('student_id');

        $points = [];
        foreach ($students = Student::whereIn('id', $studentIds)->orderBy('first_name')->get() as $student) {
            $byGame = $rows->get($student->id, collect())->keyBy('game_type');
            $scores = [];

            foreach (self::GAME_TYPES as $game) {
                $row = $byGame->get($game);
                $scores[$game] = $row ? (int) $row->points : null;
            }

            $points[] = [
                'student_id' => $student->id,
                'name' => $student->name,
                'scores' => $scores,
                'total' => (int) $byGame->sum('points'),
                'awards' => (int) $byGame->sum('awards'),
            ];
        }

        return $points;
    }

    /**
     * One row per student holding a separate score for every game type and every
     * ECCD domain, plus the section they belong to, so a table can show the
     * categories as their own columns instead of one blended average.
     */
    public function studentCategoryBreakdown(array $studentIds): array
    {
        if (empty($studentIds)) {
            return [];
        }

        $classes = Student::whereIn('id', $studentIds)
            ->pluck('class_name', 'id');

        $domains = collect($this->domainMasteryByStudent($studentIds))->keyBy('student_id');
        $points = collect($this->pointsByStudent($studentIds))->keyBy('student_id');

        $rows = [];
        foreach ($this->gameMasteryByStudent($studentIds) as $gameRow) {
            $domainRow = $domains->get($gameRow['student_id'], ['scores' => [], 'overall' => null, 'assessed' => 0]);
            $pointRow = $points->get($gameRow['student_id'], ['scores' => [], 'total' => 0, 'awards' => 0]);

            $rows[] = [
                'student_id' => $gameRow['student_id'],
                'name' => $gameRow['name'],
                'class_name' => $classes->get($gameRow['student_id']),
                'games' => $gameRow['scores'],
                'domains' => $domainRow['scores'],
                'game_overall' => $gameRow['overall'],
                'domain_overall' => $domainRow['overall'],
                'attempts' => $gameRow['attempts'],
                'points' => $pointRow['scores'],
                'total_points' => $pointRow['total'],
                'awards' => $pointRow['awards'],
            ];
        }

        return $rows;
    }

    /**
     * Section level rollup of the same category scores, for the "score per
     * section" summary.
     */
    public function sectionScoreBreakdown(array $studentIds): array
    {
        $rows = $this->studentCategoryBreakdown($studentIds);

        if ($rows === []) {
            return [];
        }

        $legend = $this->sectionLegend(
            Student::whereIn('id', collect($rows)->pluck('student_id'))
                ->get(['class_name'])
        );

        $buckets = [];
        foreach ($rows as $row) {
            $label = Student::sectionLabel($row['class_name']);
            $buckets[$label] ??= ['games' => [], 'domains' => [], 'points' => []];

            foreach ($row['games'] as $game => $pct) {
                if ($pct !== null) {
                    $buckets[$label]['games'][] = $pct;
                }
            }
            foreach ($row['domains'] as $domain => $pct) {
                if ($pct !== null) {
                    $buckets[$label]['domains'][] = $pct;
                }
            }
            if ($row['total_points'] > 0) {
                $buckets[$label]['points'][] = $row['total_points'];
            }
        }

        $average = fn (array $values) => $values ? (int) round(array_sum($values) / count($values)) : null;

        return collect($legend)
            ->map(function (array $entry) use ($buckets, $average) {
                $bucket = $buckets[$entry['label']] ?? ['games' => [], 'domains' => [], 'points' => []];

                return [
                    'label' => $entry['label'],
                    'color' => $entry['color'],
                    'students' => $entry['total'],
                    'game_pct' => $average($bucket['games']),
                    'domain_pct' => $average($bucket['domains']),
                    'avg_points' => $average($bucket['points']),
                    'total_points' => (int) array_sum($bucket['points']),
                ];
            })
            ->values()
            ->all();
    }

