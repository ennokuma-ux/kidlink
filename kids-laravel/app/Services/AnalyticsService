    /**
     * Monthly account sign-ups per role.
     */
    public function roleGrowthTrend(int $months = 6): array
    {
        $series = [];

        for ($i = $months - 1; $i >= 0; $i--) {
            $month = Carbon::today()->startOfMonth()->subMonths($i);

            $rows = User::whereBetween('created_at', [$month, $month->copy()->endOfMonth()])
                ->selectRaw('role, COUNT(*) as total')
                ->groupBy('role')
                ->pluck('total', 'role');

            $series[] = [
                'month' => $month->format('M Y'),
                'teachers' => (int) ($rows['teacher'] ?? 0),
