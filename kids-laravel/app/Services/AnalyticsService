    /**
     * Game popularity across every student in the system.
     */
    public function globalGamePopularity(?array $studentIds = null): array
    {
        $query = GameScore::selectRaw('game_type, COUNT(*) as plays, COUNT(DISTINCT student_id) as students, ' . self::ACCURACY_SQL . ' as avg_pct')
            ->groupBy('game_type');

        if ($studentIds !== null) {
            $query->whereIn('student_id', $studentIds);
        }

        $rows = $query->get()->keyBy('game_type');

        $popularity = [];
        foreach (self::GAME_TYPES as $game) {
            $row = $rows->get($game);
            $popularity[$game] = $row ? [
                'plays' => (int) $row->plays,
                'students' => (int) $row->students,
                'avg_pct' => (int) round((float) $row->avg_pct),
            ] : [
                'plays' => 0,
                'students' => 0,
                'avg_pct' => 0,
            ];
        }

        return $popularity;
    }

    /**
     * ECCD achievement per domain across the whole centre.
     */
    public function globalDomainMastery(?array $studentIds = null): array
    {
        $query = EccdRecord::selectRaw('domain, COUNT(*) as total, SUM(CASE WHEN status = \'Achieved\' THEN 1 ELSE 0 END) as achieved')
            ->groupBy('domain');

        if ($studentIds !== null) {
            $query->whereIn('student_id', $studentIds);
        }

        $rows = $query->get()->keyBy('domain');

        $mastery = [];
        foreach (self::ECCD_DOMAINS as $domain) {
            $row = $rows->get($domain);
            $total = (int) ($row->total ?? 0);
            $mastery[] = [
                'domain' => $domain,
                'pct' => $total > 0 ? (int) round(((int) $row->achieved / $total) * 100) : 0,
                'assessed' => $total,
            ];
        }

        usort($mastery, fn($a, $b) => $b['pct'] <=> $a['pct']);

        return $mastery;
    }

