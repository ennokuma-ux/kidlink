    public function classDistribution(?array $studentIds = null): array
    {
        $query = Student::selectRaw('class_name, COUNT(*) as total')
            ->groupBy('class_name')
            ->orderByDesc('total');

        if ($studentIds !== null) {
            $query->whereIn('id', $studentIds);
        }

        return $query->get()
            ->map(fn($row) => [
                'class_name' => Student::sectionLabel($row->class_name),
