    /**
     * Mean percentage of "Achieved" ECCD indicators per domain.
     */
    public function radar(?array $studentIds): array
    {
        if (empty($studentIds)) {
            return array_fill_keys(self::ECCD_DOMAINS, 0);
        }

        $counts = EccdRecord::whereIn('student_id', $studentIds)
            ->selectRaw('domain, COUNT(*) as total, SUM(CASE WHEN status = \'Achieved\' THEN 1 ELSE 0 END) as achieved')
            ->groupBy('domain')
            ->get()
            ->keyBy('domain');

        $radar = [];
        foreach (self::ECCD_DOMAINS as $domain) {
            $row = $counts->get($domain);
            $total = (int) ($row->total ?? 0);
            $radar[$domain] = $total > 0
                ? (int) round(((int) $row->achieved / $total) * 100)
                : 0;
        }

        return $radar;
    }

    /**
     * Share of every ECCD indicator by status, for the current cohort.
     */
    public function domainStatusBreakdown(?array $studentIds): array
    {
        if (empty($studentIds)) {
            return ['Achieved' => 0, 'In Progress' => 0, 'Not Yet' => 0];
        }

        $rows = EccdRecord::whereIn('student_id', $studentIds)
            ->selectRaw('status, COUNT(*) as total')
            ->groupBy('status')
            ->pluck('total', 'status');

        return [
            'Achieved' => (int) ($rows['Achieved'] ?? 0),
            'In Progress' => (int) ($rows['In Progress'] ?? 0),
            'Not Yet' => (int) ($rows['Not Yet'] ?? 0),
        ];
    }

    /**
     * Monthly present / absent / late totals plus a present-rate percentage.
     */
    public function attendanceRateTrend(?array $studentIds, int $months = 6): array
    {
        $series = [];

        for ($i = $months - 1; $i >= 0; $i--) {
            $month = Carbon::today()->startOfMonth()->subMonths($i);
            $end = $month->copy()->endOfMonth();

            $query = Attendance::whereBetween('date', [$month, $end]);
            if (!empty($studentIds)) {
                $query->whereIn('student_id', $studentIds);
            }

            $rows = $query
                ->selectRaw('status, COUNT(*) as total')
                ->groupBy('status')
                ->pluck('total', 'status');

            $present = (int) ($rows['Present'] ?? 0);
            $total = (int) $rows->sum();

            $series[] = [
                'month' => $month->format('M Y'),
                'present' => $present,
                'absent' => (int) ($rows['Absent'] ?? 0),
                'late' => (int) ($rows['Late'] ?? 0),
                'rate' => $total > 0 ? round(($present / $total) * 100) : 0,
            ];
        }

        return $series;
    }

    /**
     * Present / absent / late split for each weekday of the current week.
     */
    public function weeklyBreakdown(?array $studentIds): array
    {
        $breakdown = [];
        $weekStart = Carbon::today()->startOfWeek();

        for ($i = 0; $i < 7; $i++) {
            $date = $weekStart->copy()->addDays($i);

            $query = Attendance::whereDate('date', $date);
            if (!empty($studentIds)) {
                $query->whereIn('student_id', $studentIds);
            }

            $rows = $query
                ->selectRaw('status, COUNT(*) as total')
                ->groupBy('status')
                ->pluck('total', 'status');

            $breakdown[] = [
                'day' => $date->format('D'),
                'date' => $date->format('Y-m-d'),
                'present' => (int) ($rows['Present'] ?? 0),
                'absent' => (int) ($rows['Absent'] ?? 0),
                'late' => (int) ($rows['Late'] ?? 0),
            ];
        }

        return $breakdown;
    }

    /**
     * Cohort mean percentage per game type, plus attempts and best level.
     */
    public function gamePerformance(?array $studentIds): array
    {
        if (empty($studentIds)) {
            return collect(self::GAME_TYPES)->mapWithKeys(fn($g) => [$g => null])->all();
        }

        $rows = GameScore::whereIn('student_id', $studentIds)
            ->selectRaw('game_type, COUNT(*) as attempts, ' . self::ACCURACY_SQL . ' as avg_pct, MAX(level) as best_level')
            ->groupBy('game_type')
            ->get()
            ->keyBy('game_type');

        $performance = [];
        foreach (self::GAME_TYPES as $game) {
            $row = $rows->get($game);
            $performance[$game] = $row ? [
                'attempts' => (int) $row->attempts,
                'avg_pct' => (int) round((float) $row->avg_pct),
                'best_level' => (int) $row->best_level,
            ] : null;
        }

        return $performance;
    }

