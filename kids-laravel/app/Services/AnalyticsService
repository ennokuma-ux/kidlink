    /**
     * Each teacher's caseload and how hard their students are working.
     */
    public function teacherWorkload(int $limit = 10): array
    {
        $teachers = User::where('role', 'teacher')->orderBy('first_name')->get();

        $studentCounts = Student::selectRaw('teacher_id, COUNT(*) as total, SUM(CASE WHEN is_active THEN 1 ELSE 0 END) as active')
            ->whereNotNull('teacher_id')
            ->groupBy('teacher_id')
            ->get()
            ->keyBy('teacher_id');

        $scoreRows = GameScore::whereIn('student_id', Student::whereNotNull('teacher_id')->select('id'))
            ->join('students', 'game_scores.student_id', '=', 'students.id')
            ->whereNotNull('students.teacher_id')
            ->selectRaw('students.teacher_id, COUNT(*) as plays, ' . self::ACCURACY_SQL . ' as avg_pct')
            ->groupBy('students.teacher_id')
            ->get()
            ->keyBy('teacher_id');

        $eccdRows = EccdRecord::whereIn('student_id', Student::whereNotNull('teacher_id')->select('id'))
            ->join('students', 'eccd_records.student_id', '=', 'students.id')
            ->whereNotNull('students.teacher_id')
            ->selectRaw('students.teacher_id, SUM(CASE WHEN eccd_records.status = \'Achieved\' THEN 1 ELSE 0 END) * 100.0 / NULLIF(COUNT(*), 0) as pct')
            ->groupBy('students.teacher_id')
            ->get()
            ->keyBy('teacher_id');

        $workload = [];
        foreach ($teachers as $teacher) {
            $students = $studentCounts->get($teacher->id);
            $scores = $scoreRows->get($teacher->id);
            $eccd = $eccdRows->get($teacher->id);

            $workload[] = [
                'teacher_id' => $teacher->id,
                'name' => $teacher->full_name,
                'students' => (int) ($students->total ?? 0),
                'active_students' => (int) ($students->active ?? 0),
                'plays' => (int) ($scores->plays ?? 0),
                'avg_pct' => $scores ? (int) round((float) $scores->avg_pct) : 0,
                'eccd_pct' => $eccd ? (int) round((float) $eccd->pct) : 0,
            ];
        }

        return $this->sortByPct($workload, $limit);
    }

    /**
     * Students with the strongest recorded game performance.
     */
    public function topStudents(int $limit = 8, ?array $studentIds = null): array
    {
        $query = GameScore::selectRaw('student_id, ' . self::ACCURACY_SQL . ' as avg_pct, COUNT(*) as plays, MAX(level) as best_level')
            ->groupBy('student_id')
            ->havingRaw(self::ACCURACY_SQL . ' IS NOT NULL')
            ->orderByDesc('avg_pct');

        if ($studentIds !== null) {
            $query->whereIn('student_id', $studentIds);
        }

        return $query->limit($limit)
            ->get()
            ->map(function ($row) {
                $student = Student::find($row->student_id);
                return [
                    'student_id' => $row->student_id,
                    'name' => $student?->name ?? 'Unknown',
                    'class_name' => $student?->class_name,
                    'avg_pct' => (int) round((float) $row->avg_pct),
                    'plays' => (int) $row->plays,
                    'best_level' => (int) $row->best_level,
                ];
            })
            ->values()
            ->all();
    }

